{
  "name": "hsilveira",
  "main": "./worker/src/index.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/contact"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://hsilveira.com.br",
    "TO_EMAIL": "contato@hsilveira.com.br",
    "FROM_EMAIL": "Portfolio Henrique Silveira <contato@hsilveira.com.br>"
  }
}
